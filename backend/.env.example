# ============================================================================
# NHIS Assistant — backend configuration
# ============================================================================
# Copy this file to `.env` and edit. NEVER commit `.env` to git.
# In production, set APP_ENV=production — the server will refuse to start
# while any default secret/credential below is still in place.
# ============================================================================

# Environment: "development" | "production"
APP_ENV=development

# ----- LLM provider --------------------------------------------------------
# Pick one provider. Defaults to anthropic. Vision features (prescription
# analyzer, drug-photo identifier) require ANTHROPIC_API_KEY.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----- Embeddings / vector store -------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/processed/chroma
CHROMA_COLLECTION=nhis_policies

# ----- Seed data paths -----------------------------------------------------
MEDICINES_CSV=./data/raw/medicines.csv
FACILITIES_CSV=./data/raw/facilities.csv
POLICIES_DIR=./data/raw/policies
KNOWLEDGE_BASE_DIR=./data/raw/knowledge_base

# ----- Database ------------------------------------------------------------
# Default SQLite is fine for development. For production use a managed
# Postgres: postgresql+psycopg://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///./data/processed/app.db

# ----- Auth ----------------------------------------------------------------
# JWT_SECRET MUST be a long random string in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=please-change-me-in-production-this-is-only-for-dev
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# ----- Initial admin (auto-created if no admin exists) ---------------------
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme123

# ----- Rate limits (requests per minute per IP) ---------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# ----- Agent loop ---------------------------------------------------------
AGENT_MAX_TOOL_ITERATIONS=4
AGENT_MAX_HISTORY_TURNS=10

# ----- LLM retry / backoff -----------------------------------------------
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY=0.5
LLM_RETRY_MAX_DELAY=4.0

# ----- Logging ------------------------------------------------------------
LOG_LEVEL=INFO

# ----- CORS (comma-separated origins) -------------------------------------
# Use exact frontend origin(s) in production. "*" is dev-only.
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=*

# ----- API ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
