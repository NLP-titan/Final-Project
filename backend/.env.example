# LLM provider config — pick one. Defaults to anthropic.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=~google/gemini-pro-latest
JUDGE_MODEl=openai/gpt-5.4

# Embedding model (HuggingFace name; runs locally via sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vector store
CHROMA_PERSIST_DIR=./data/processed/chroma
CHROMA_COLLECTION=nhis_policies

# Structured data paths (used as seed when DB is empty)
MEDICINES_CSV=./data/raw/medicines.csv
FACILITIES_CSV=./data/raw/facilities.csv
POLICIES_DIR=./data/raw/policies
KNOWLEDGE_BASE_DIR=./data/raw/knowledge_base

# Database
DATABASE_URL=sqlite:///./data/processed/app.db

# Auth — set JWT_SECRET to a long random string in production
JWT_SECRET=please-change-me-in-production-this-is-only-for-dev
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# First admin (created on startup if no admin exists)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=changeme123

# Rate limiting (requests per window per IP). 0 disables.
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_CHAT_PER_MINUTE=20

# Logging
LOG_LEVEL=INFO

# CORS (comma-separated origins; * during dev)
CORS_ORIGINS=*

# API
API_HOST=0.0.0.0
API_PORT=8000
