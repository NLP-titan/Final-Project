# Frontend configuration. Copy to `.env.local` (untracked) for dev overrides
# or set as build-time env vars in your hosting provider for production.

# In dev, this is the proxy target; leave unset for the default localhost:8000.
VITE_API_PROXY_TARGET=http://localhost:8000

# In a production build, set this to the absolute URL of the backend API.
# Leave blank to use a same-origin /api path (works when frontend + backend
# are served from the same hostname).
VITE_API_BASE_URL=

# Request timeout for fetch calls in milliseconds.
VITE_API_TIMEOUT_MS=60000

# Vite dev server port.
VITE_DEV_PORT=5173
